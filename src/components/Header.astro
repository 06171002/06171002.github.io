---
import { getCollection } from 'astro:content';
import { siGithub } from 'simple-icons';
import { profile } from '../data/profile';
import { projectKeys, projects } from '../data/projects';
import ThemeToggle from './ThemeToggle.astro';

// 카드가 있는 프로젝트만 메뉴에 둔다 — 공개 카드가 없으면 프로젝트 페이지 자체가 없다
const entries = await getCollection('features');
const available = projectKeys.filter((key) => entries.some((entry) => entry.data.project === key));
const path = Astro.url.pathname;
---

<header class="site-header">
    <nav class="site-nav" aria-label="사이트">
        <ul>
            <li>
                <a href="/" aria-current={path === '/' ? 'page' : undefined}>
                    {profile.name}
                </a>
            </li>
            {available.map((key) => (
                <li>
                    <a href={`/${key}/`} aria-current={path.startsWith(`/${key}/`) ? 'page' : undefined}>
                        {projects[key].short}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
    <div class="header-actions">
        <a class="header-icon" href={`mailto:${profile.email}`} aria-label="메일 보내기">
            <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
            </svg>
        </a>
        <a class="header-icon" href={profile.github} aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={siGithub.path}></path>
            </svg>
        </a>
        <span class="header-divider" aria-hidden="true"></span>
        <ThemeToggle />
    </div>
</header>

<script>
    // 좁은 화면의 메뉴는 가로로 넘치면 옆으로 밀어 본다. 지금 페이지의 메뉴가 오른쪽에서 잘리면
    // 메뉴만 그만큼 밀어 보이게 한다 (페이지는 움직이지 않는다)
    const nav = document.querySelector<HTMLElement>('.site-nav');
    const current = nav?.querySelector<HTMLElement>('a[aria-current="page"]');
    if (nav && current) {
        const hidden = current.getBoundingClientRect().right - nav.getBoundingClientRect().right;
        if (hidden > 0) nav.scrollLeft += hidden;
    }
</script>
