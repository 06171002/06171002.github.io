---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import { projectKeys, projects } from '../data/projects';
import ThemeToggle from './ThemeToggle.astro';

// 카드가 있는 프로젝트만 메뉴에 둔다 — 공개 카드가 없으면 프로젝트 페이지 자체가 없다
const entries = await getCollection('features');
const available = projectKeys.filter((key) => entries.some((entry) => entry.data.project === key));
const path = Astro.url.pathname;
---

<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="/">
            <span class="brand-name">{profile.name}</span>
            <span class="brand-sub" aria-hidden="true">
                Backend · Portfolio
            </span>
        </a>
        {available.length > 0 && (
            <nav class="site-nav" aria-label="프로젝트">
                <ul>
                    {available.map((key) => (
                        <li>
                            <a href={`/${key}/`} aria-current={path.startsWith(`/${key}/`) ? 'page' : undefined}>
                                {projects[key].short}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        )}
        <ThemeToggle />
    </div>
</header>

<script>
    // 좁은 화면의 메뉴는 가로로 넘치면 옆으로 밀어 본다. 지금 프로젝트의 알약이 오른쪽에서 잘리면
    // 메뉴만 그만큼 밀어 보이게 한다 (페이지는 움직이지 않는다)
    const nav = document.querySelector<HTMLElement>('.site-nav');
    const current = nav?.querySelector<HTMLElement>('a[aria-current="page"]');
    if (nav && current) {
        const hidden =
            current.getBoundingClientRect().right -
            nav.getBoundingClientRect().right +
            parseFloat(getComputedStyle(nav).paddingRight);
        if (hidden > 0) nav.scrollLeft += hidden;
    }
</script>
