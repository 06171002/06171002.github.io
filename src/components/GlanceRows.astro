---
// 대표 사례의 문제 · 해결 · 결과 — 카드 맨 위 '한눈에' (docs/design.md 5.3)
// 문장은 노션 공개용 사본의 속성이다. 한 줄에 한 항목
interface Props {
    problem: string[];
    solution: string[];
    result: string[];
}

const { problem, solution, result } = Astro.props;
const rows = [
    { label: '문제', lines: problem },
    { label: '해결', lines: solution },
    { label: '결과', lines: result },
];
---

<dl class="glance-rows">
    {rows.map((row) => (
        <div class="glance-row">
            <dt>{row.label}</dt>
            <dd>
                {row.lines.length === 1 ? (
                    row.lines[0]
                ) : (
                    <ul>
                        {row.lines.map((line) => (
                            <li>{line}</li>
                        ))}
                    </ul>
                )}
            </dd>
        </div>
    ))}
</dl>

<style>
    .glance-rows {
        display: grid;
        gap: 0.625rem;
        margin: 0;
    }

    /* 이름 칸 + 내용 칸. 이름은 내용 첫 줄의 글자 기준선에 맞춘다 */
    .glance-row {
        display: grid;
        grid-template-columns: 2.25rem minmax(0, 1fr);
        align-items: baseline;
        gap: 0 0.625rem;
    }

    dt {
        color: var(--muted);
        font-size: var(--text-sm);
        font-weight: 700;
    }

    dd {
        margin: 0;
    }

    ul {
        margin: 0;
        padding-left: 1.125rem;
    }

    li + li {
        margin-top: 0.25rem;
    }
</style>
