---
// 대표 사례의 문제 · 해결 · 결과 — 카드 맨 위 '한눈에' (docs/design.md 5.3)
// 문장은 노션 공개용 사본의 속성이다. 한 줄에 한 항목
interface Props {
    problem: string[];
    solution: string[];
    result: string[];
}

const { problem, solution, result } = Astro.props;
const rows = [
    { label: 'Problem · 문제', lines: problem },
    { label: 'Solution · 해결', lines: solution },
    { label: 'Result · 결과', lines: result },
];
---

<dl class="glance-rows">
    {rows.map((row) => (
        <div class="glance-row">
            <dt>{row.label}</dt>
            <dd>
                {row.lines.length === 1 ? (
                    row.lines[0]
                ) : (
                    <ul>
                        {row.lines.map((line) => (
                            <li>{line}</li>
                        ))}
                    </ul>
                )}
            </dd>
        </div>
    ))}
</dl>

<style>
    /* 문제 · 해결 · 결과 세 칸 — 넓으면 가로 3칸, 좁으면 세로로. 칸 사이 가는 선 */
    .glance-rows {
        display: grid;
        margin: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }

    .glance-row {
        padding: 1rem 1.125rem 1.125rem;
        border-bottom: 1px solid var(--border);
    }

    .glance-row:last-child {
        border-bottom: 0;
    }

    @media (min-width: 720px) {
        .glance-rows {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .glance-row {
            border-right: 1px solid var(--border);
            border-bottom: 0;
        }

        .glance-row:last-child {
            border-right: 0;
        }
    }

    dt {
        margin: 0 0 0.5rem;
        color: var(--accent);
        font-family: var(--font-label);
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    dd {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.65;
    }

    ul {
        margin: 0;
        padding-left: 1rem;
    }

    li + li {
        margin-top: 0.375rem;
    }
</style>
