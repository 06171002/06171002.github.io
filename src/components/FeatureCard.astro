---
import type { CollectionEntry } from 'astro:content';
import EvidenceBadges from './EvidenceBadges.astro';

interface Props {
    entry: CollectionEntry<'features'>;
}

const { entry } = Astro.props;
const data = entry.data;
// 노션 커버 이미지 대신 카드 데이터로 같은 모양을 그린다 — 다크 모드에서도 어울리고, 커버 없는 카드도 같은 모양이 된다.
// API 수 · 테이블 수는 프로젝트 내부 정보라 싣지 않는다 (docs/design.md 6.5) → 표지엔 앞 키워드 2개, 본문엔 그다음 키워드
const coverKeywords = data.keywords.slice(0, 2);
const bodyKeywords = data.keywords.slice(2, 5);
---

<li class={`feature-card project-${data.project}`}>
    <a href={`/${data.project}/${entry.id}/`}>
        <div class="feature-cover" aria-hidden="true">
            {data.domain && <span class="feature-domain">{data.domain}</span>}
            {coverKeywords.length > 0 && <span class="feature-cover-keywords">{coverKeywords.join(' · ')}</span>}
        </div>
        <div class="feature-body">
            <h3 class="feature-title">
                {data.title}
                {data.draft && <span class="draft-tag">초안</span>}
            </h3>
            <EvidenceBadges kinds={data.evidence} />
            {bodyKeywords.length > 0 && <p class="feature-keywords">{bodyKeywords.join(' · ')}</p>}
        </div>
    </a>
</li>

<style>
    .feature-card a {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        color: var(--fg);
        text-decoration: none;
        transition: border-color 0.15s ease;
    }

    .feature-card a:hover {
        border-color: var(--accent);
    }

    .feature-cover {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.75rem;
        min-height: 5.5rem;
        padding: 0.875rem 1rem;
        border-bottom: 1px solid var(--border);
        border-left: 5px solid var(--project-color);
        background: var(--project-bg);
    }

    .project-b2b {
        --project-color: var(--project-b2b);
        --project-bg: var(--project-b2b-bg);
    }

    .project-stt {
        --project-color: var(--project-stt);
        --project-bg: var(--project-stt-bg);
    }

    .feature-domain {
        align-self: flex-start;
        padding: 0 0.5rem;
        border: 1px solid var(--project-color);
        border-radius: 999px;
        color: var(--project-color);
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1.6;
    }

    .feature-cover-keywords {
        color: var(--project-color);
        font-size: var(--text-sm);
        font-weight: 600;
    }

    .feature-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.875rem 1rem 1rem;
    }

    .feature-title {
        margin: 0;
        font-size: 1.0625rem;
        line-height: 1.4;
    }

    .feature-keywords {
        margin: 0;
        color: var(--muted);
        font-size: var(--text-xs);
    }
</style>
