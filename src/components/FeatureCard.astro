---
import type { CollectionEntry } from 'astro:content';
import { evidenceLabel } from '../data/projects';

interface Props {
    entry: CollectionEntry<'features'>;
}

const { entry } = Astro.props;
const data = entry.data;
// 가는 선 목록의 한 줄 — 왼쪽 제목(+ 대표 사례의 성과 제목), 오른쪽 근거 종류.
// API 수 · 테이블 수는 프로젝트 내부 정보라 싣지 않는다 (docs/design.md 6.5)
const evidence = data.evidence.map((kind) => evidenceLabel[kind]).join(' · ');
---

<li>
    <a href={`/${data.project}/${entry.id}/`}>
        <span class="row-info">
            <span class="row-title">
                {data.title}
                {data.draft && <span class="draft-tag">초안</span>}
            </span>
            {data.glance && <span class="row-sub">{data.glance.headline}</span>}
        </span>
        {evidence && <span class="row-side">{evidence}</span>}
    </a>
</li>
