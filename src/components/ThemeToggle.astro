<button class="theme-toggle" type="button" data-theme-toggle aria-label="테마 전환">
    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path
            d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        ></path>
    </svg>
    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </g>
    </svg>
</button>

<script>
    // 기본은 시스템 설정. 누르면 반대 테마로 고정하고 기억한다 (첫 화면 깜빡임 방지는 Base.astro 의 인라인 스크립트)
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => (root.dataset.theme ?? (media.matches ? 'dark' : 'light')) === 'dark';

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
        const sync = () => {
            const dark = isDark();
            button.dataset.state = dark ? 'dark' : 'light';
            button.setAttribute('aria-label', dark ? '라이트 모드로 전환' : '다크 모드로 전환');
        };
        button.addEventListener('click', () => {
            const next = isDark() ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
                localStorage.setItem('theme', next);
            } catch {
                // 저장소를 못 쓰는 환경이면 이번 화면에만 적용
            }
            sync();
        });
        media.addEventListener('change', sync);
        sync();
    }
</script>
