---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다 · 이상진" description="요청한 페이지가 없습니다.">
    <main class="wrap">
        <h1>페이지를 찾을 수 없습니다</h1>
        <p>주소가 바뀌었거나 아직 옮기지 않은 페이지입니다.</p>
        <p>
            <a href="/">홈으로</a>
        </p>
    </main>
</Base>

<style>
    .wrap {
        max-width: 40rem;
        margin: 0 auto;
        padding: 4rem 1rem;
    }

    h1 {
        margin: 0 0 1rem;
        font-size: 1.75rem;
        line-height: 1.3;
    }
</style>
