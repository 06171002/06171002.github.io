---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다 · 이상진" description="요청한 페이지가 없습니다." noindex>
    <main id="main" class="container not-found">
        <header class="page-head">
            <h1 class="page-title">페이지를 찾을 수 없습니다</h1>
            <p class="page-meta">주소가 바뀌었거나 아직 옮기지 않은 페이지입니다.</p>
        </header>
        <p>
            <a class="btn btn-secondary" href="/">
                홈으로
            </a>
        </p>
    </main>
</Base>

<style>
    .not-found p {
        margin: 0;
        text-align: center;
    }
</style>
