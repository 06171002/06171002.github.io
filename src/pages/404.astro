---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다 · 이상진" description="요청한 페이지가 없습니다.">
    <main id="main" class="container not-found">
        <h1>페이지를 찾을 수 없습니다</h1>
        <p>주소가 바뀌었거나 아직 옮기지 않은 페이지입니다.</p>
        <p>
            <a href="/">홈으로</a>
        </p>
    </main>
</Base>

<style>
    .not-found {
        padding-top: 4rem;
    }

    h1 {
        margin: 0 0 1rem;
        font-size: 1.75rem;
    }
</style>
