---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import EvidenceBadges from '../../components/EvidenceBadges.astro';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import '../../styles/content.css';

export async function getStaticPaths() {
    const entries = await getCollection('features');
    return entries.map((entry) => {
        // 같은 프로젝트 안에서 노션 순서대로 이전 · 다음
        const siblings = entries
            .filter((other) => other.data.project === entry.data.project)
            .sort((a, b) => a.data.order - b.data.order);
        const index = siblings.findIndex((other) => other.id === entry.id);
        const link = (other: (typeof siblings)[number] | undefined) =>
            other ? { href: `/${other.data.project}/${other.id}/`, title: other.data.title } : null;
        return {
            params: { project: entry.data.project, slug: entry.id },
            props: { entry, prev: link(siblings[index - 1]), next: link(siblings[index + 1]) },
        };
    });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next } = Astro.props as Props;
const { Content, headings } = await render(entry);
const data = entry.data;
const project = projects[data.project];
const toc = headings.filter((heading) => heading.depth === 2);
// 본문의 "현재" · "5주 전" 같은 상대 표현의 기준점 (docs/design.md 5.3)
const basis = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long', timeZone: 'Asia/Seoul' }).format(
    data.notionEditedAt
);
const meta = [data.domain, `${basis} 기준`].filter(Boolean);
---

<Base title={`${data.title} · 이상진`} description={`${project.name} — ${data.title}`}>
    <main id="main" class="article">
        <article class="article-main">
            {data.draft && <p class="draft-banner">초안 · 공개 점검 전이라 배포되지 않는 페이지입니다</p>}
            <header class="doc-head">
                <nav class="crumbs" aria-label="경로">
                    <a href="/">홈</a> › <a href={`/${data.project}/`}>{project.name}</a>
                </nav>
                <h1 class="doc-title">{data.title}</h1>
                <p class="doc-meta">{meta.join(' · ')}</p>
                <EvidenceBadges kinds={data.evidence} />
                {data.keywords.length > 0 && (
                    <ul class="chip-list" aria-label="핵심 키워드">
                        {data.keywords.map((keyword) => (
                            <li class="chip">{keyword}</li>
                        ))}
                    </ul>
                )}
            </header>

            {toc.length > 1 && (
                <details class="toc-mobile toc">
                    <summary>목차 {toc.length}</summary>
                    <ol>
                        {toc.map((heading) => (
                            <li>
                                <a href={`#${heading.slug}`}>{heading.text}</a>
                            </li>
                        ))}
                    </ol>
                </details>
            )}

            <div class="prose">
                <Content />
            </div>

            {(prev || next) && (
                <nav class="pager" aria-label="같은 프로젝트의 다른 기능">
                    {prev ? (
                        <a class="prev" href={prev.href}>
                            <span>← 이전</span>
                            {prev.title}
                        </a>
                    ) : (
                        <i />
                    )}
                    {next && (
                        <a class="next" href={next.href}>
                            <span>다음 →</span>
                            {next.title}
                        </a>
                    )}
                </nav>
            )}
        </article>

        {toc.length > 1 && (
            <aside class="toc-aside toc" aria-label="목차">
                <p class="toc-title">목차</p>
                <ol>
                    {toc.map((heading) => (
                        <li>
                            <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                    ))}
                </ol>
            </aside>
        )}
    </main>
</Base>

<script>
    // 지금 읽는 절을 목차에 표시한다 (없어도 목차는 동작한다)
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-aside a')];
    const byId = new Map(links.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
    const observer = new IntersectionObserver(
        (records) => {
            for (const record of records) {
                if (!record.isIntersecting) continue;
                for (const link of links) link.removeAttribute('aria-current');
                byId.get(record.target.id)?.setAttribute('aria-current', 'true');
            }
        },
        { rootMargin: '0px 0px -70% 0px' }
    );
    for (const heading of document.querySelectorAll('.prose h2[id]')) observer.observe(heading);
</script>
