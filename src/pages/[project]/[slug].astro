---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import CardRefs from '../../components/CardRefs.astro';
import EvidenceBadges from '../../components/EvidenceBadges.astro';
import GlanceRows from '../../components/GlanceRows.astro';
import ImageSizes from '../../components/ImageSizes.astro';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import { describe } from '../../lib/describe';
import { svgSize } from '../../lib/figure-size';
import '../../styles/content.css';

export async function getStaticPaths() {
    const entries = await getCollection('features');
    const href = (entry: (typeof entries)[number]) => `/${entry.data.project}/${entry.id}/`;
    // 본문의 「카드 제목」 참조가 가리킬 수 있는 카드 — 초안 · 자기 자신은 CardRefs 가 거른다
    const cards = entries.map((entry) => ({ title: entry.data.title, href: href(entry), draft: entry.data.draft }));
    return entries.map((entry) => {
        // 같은 프로젝트 안에서 노션 순서대로 이전 · 다음
        const siblings = entries
            .filter((other) => other.data.project === entry.data.project)
            .sort((a, b) => a.data.order - b.data.order);
        const index = siblings.findIndex((other) => other.id === entry.id);
        const link = (other: (typeof siblings)[number] | undefined) =>
            other ? { href: href(other), title: other.data.title } : null;
        return {
            params: { project: entry.data.project, slug: entry.id },
            props: {
                entry,
                prev: link(siblings[index - 1]),
                next: link(siblings[index + 1]),
                cards,
                self: href(entry),
            },
        };
    });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next, cards, self } = Astro.props as Props;
const { Content, headings } = await render(entry);
const data = entry.data;
const project = projects[data.project];
const toc = headings.filter((heading) => heading.depth === 2);
// 본문의 "현재" · "5주 전" 같은 상대 표현의 기준점 (docs/design.md 5.3)
const basis = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long', timeZone: 'Asia/Seoul' }).format(
    data.notionEditedAt
);
const meta = [data.domain, `${basis} 기준`].filter(Boolean);
// '한눈에' — 성과 제목 + 그림 + 문제 · 해결 · 결과 (docs/design.md 5.3). 문장은 대표 사례만, 그림은 어느 카드나 가질 수 있다
const glance = data.glance ?? null;
const leadFigure = data.leadFigure ?? null;
// 그림이 뜨기 전에 자리를 잡도록 SVG viewBox 의 가로 · 세로를 속성으로 붙인다 (라이트 · 다크는 같은 크기)
const leadSize = leadFigure ? svgSize(leadFigure.light) : null;
// 검색 · 공유 설명: 사본의 '요약' 속성 → 성과 제목 → 개요 첫 문단 → 제목 + 키워드
const description =
    data.description ??
    glance?.headline ??
    describe(entry.body ?? '') ??
    `${data.title} — ${project.name}. ${data.keywords.join(' · ')}`;
---

<Base
    title={`${data.title} · 이상진`}
    description={description}
    image={`/og/${data.project}/${entry.id}.png`}
    imageAlt={`${project.name} — ${data.title}`}
    type="article"
    modified={data.notionEditedAt}
>
    <main id="main" class="article">
        <article class="article-main">
            {data.draft && <p class="draft-banner">초안 · 공개 점검 전이라 배포되지 않는 페이지입니다</p>}
            <header class="doc-head">
                <nav class="crumbs" aria-label="경로">
                    <a href="/">홈</a>
                    <span class="sep" aria-hidden="true">
                        /
                    </span>
                    <a href={`/${data.project}/`}>{project.short}</a>
                </nav>
                <h1 class="doc-title">{data.title}</h1>
                <p class="doc-meta">{meta.join(' · ')}</p>
                <EvidenceBadges kinds={data.evidence} />
                {data.keywords.length > 0 && (
                    <ul class="chip-list" aria-label="핵심 키워드">
                        {data.keywords.map((keyword) => (
                            <li class="chip">{keyword}</li>
                        ))}
                    </ul>
                )}
            </header>

            {(glance || leadFigure) && (
                <section class="glance" aria-labelledby="glance-title">
                    <h2 id="glance-title" class="eyebrow glance-label">
                        At a glance · 한눈에
                    </h2>
                    {glance && <p class="glance-headline">{glance.headline}</p>}
                    {/* 첫 화면에 있는 그림이라 지연 로딩하지 않는다. 좁은 화면에서는 글자가 작아지므로 원본을 새 탭으로 연다 */}
                    {leadFigure && (
                        <figure class="diagram glance-figure">
                            <a href={leadFigure.light} target="_blank" rel="noopener">
                                <img
                                    src={leadFigure.light}
                                    alt={leadFigure.alt}
                                    width={leadSize?.width}
                                    height={leadSize?.height}
                                    class="diagram-light"
                                    decoding="async"
                                />
                                <img
                                    src={leadFigure.dark}
                                    alt={leadFigure.alt}
                                    width={leadSize?.width}
                                    height={leadSize?.height}
                                    class="diagram-dark"
                                    decoding="async"
                                />
                                <span class="glance-figure-more">그림 크게 보기 ↗</span>
                            </a>
                        </figure>
                    )}
                    {glance && (
                        <GlanceRows problem={glance.problem} solution={glance.solution} result={glance.result} />
                    )}
                </section>
            )}

            {toc.length > 1 && (
                <details class="toc-mobile toc">
                    <summary>목차 {toc.length}</summary>
                    <ol>
                        {toc.map((heading) => (
                            <li>
                                <a href={`#${heading.slug}`}>{heading.text}</a>
                            </li>
                        ))}
                    </ol>
                </details>
            )}

            <div class="prose">
                <ImageSizes>
                    <CardRefs cards={cards} self={self}>
                        <Content />
                    </CardRefs>
                </ImageSizes>
            </div>

            {(prev || next) && (
                <nav class="pager" aria-label="같은 프로젝트의 다른 기능">
                    {prev ? (
                        <a class="prev" href={prev.href}>
                            <span>← 이전</span>
                            {prev.title}
                        </a>
                    ) : (
                        <i />
                    )}
                    {next && (
                        <a class="next" href={next.href}>
                            <span>다음 →</span>
                            {next.title}
                        </a>
                    )}
                </nav>
            )}
        </article>

        {toc.length > 1 && (
            <aside class="toc-aside toc" aria-label="목차">
                <p class="toc-title label">Contents · 목차</p>
                <ol>
                    {toc.map((heading) => (
                        <li>
                            <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                    ))}
                </ol>
            </aside>
        )}
    </main>
</Base>

<script>
    // 지금 읽는 절을 목차에 표시한다 (없어도 목차는 동작한다)
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-aside a')];
    const byId = new Map(links.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
    const observer = new IntersectionObserver(
        (records) => {
            for (const record of records) {
                if (!record.isIntersecting) continue;
                for (const link of links) link.removeAttribute('aria-current');
                byId.get(record.target.id)?.setAttribute('aria-current', 'true');
            }
        },
        { rootMargin: '0px 0px -70% 0px' }
    );
    for (const heading of document.querySelectorAll('.prose h2[id]')) observer.observe(heading);
</script>
