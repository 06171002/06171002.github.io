---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import FeatureCard from '../../components/FeatureCard.astro';
import Base from '../../layouts/Base.astro';
import { projectKeys, projects } from '../../data/projects';

// 카드가 하나도 없는 프로젝트는 페이지를 만들지 않는다 (CI 에는 초안이 없으므로 공개 카드가 생길 때 나타난다)
export async function getStaticPaths() {
    const entries = await getCollection('features');
    return projectKeys
        .map((key) => ({
            key,
            items: entries.filter((entry) => entry.data.project === key).sort((a, b) => a.data.order - b.data.order),
        }))
        .filter(({ items }) => items.length > 0)
        .map(({ key, items }) => ({ params: { project: key }, props: { key, items } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { key, items } = Astro.props as Props;
const project = projects[key];
const number = String(projectKeys.indexOf(key) + 1).padStart(2, '0');
---

<Base title={`${project.name} · 이상진`} description={project.summary} image={`/og/${key}.png`}>
    <main id="main" class="project-page">
        <section class="container page-head">
            <nav class="crumbs" aria-label="경로">
                <a href="/">홈</a>
                <span class="sep" aria-hidden="true">
                    /
                </span>
                <span>{project.short}</span>
            </nav>
            <p class="eyebrow">
                Project {number} · {project.role}
            </p>
            <h1>{project.name}</h1>
            <p class="summary">{project.summary}</p>
            <p class="stack">{project.stack.join(' · ')}</p>
        </section>

        <section class="container features" aria-labelledby="features-title">
            <h2 id="features-title" class="section-label">
                Features · 담당 기능 {items.length}
            </h2>
            <ul class="feature-grid">
                {items.map((entry) => (
                    <FeatureCard entry={entry} />
                ))}
            </ul>
        </section>
    </main>
</Base>

<style>
    .page-head {
        padding-top: clamp(2.5rem, 6vw, 4.5rem);
        padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    }

    h1 {
        max-width: var(--read-width);
        margin: 0 0 1rem;
        font-size: clamp(2.125rem, 5.5vw, 3.25rem);
        line-height: 1.15;
        letter-spacing: -0.035em;
    }

    .summary {
        max-width: 42rem;
        margin: 0 0 1rem;
        color: var(--muted);
        font-size: clamp(1.0625rem, 2vw, 1.1875rem);
        line-height: 1.65;
    }

    .stack {
        margin: 0;
        color: var(--subtle);
        font-family: var(--font-label);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
    }

    /* 구분선은 머리글에 — 섹션 자체에 그으면 바깥 여백까지 뻗어 본문 폭과 어긋난다 */
    .features h2 {
        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
