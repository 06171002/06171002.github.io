---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import FeatureCard from '../../components/FeatureCard.astro';
import Base from '../../layouts/Base.astro';
import { projectKeys, projects } from '../../data/projects';

// 카드가 하나도 없는 프로젝트는 페이지를 만들지 않는다 (CI 에는 초안이 없으므로 공개 카드가 생길 때 나타난다)
export async function getStaticPaths() {
    const entries = await getCollection('features');
    return projectKeys
        .map((key) => ({
            key,
            items: entries.filter((entry) => entry.data.project === key).sort((a, b) => a.data.order - b.data.order),
        }))
        .filter(({ items }) => items.length > 0)
        .map(({ key, items }) => ({ params: { project: key }, props: { key, items } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { key, items } = Astro.props as Props;
const project = projects[key];
const meta = [project.role, project.stack.join(', ')].join(' · ');
---

<Base title={`${project.name} · 이상진`} description={project.summary} image={`/og/${key}.png`}>
    <main id="main" class="container">
        <header class="page-head">
            <h1 class="page-title">{project.name}</h1>
            <p class="page-meta">{meta}</p>
        </header>

        <p class="summary">{project.summary}</p>

        <section class="features" aria-labelledby="features-title">
            <h2 id="features-title" class="section-label">
                Features {items.length}
            </h2>
            <ol class="row-list">
                {items.map((entry) => (
                    <FeatureCard entry={entry} />
                ))}
            </ol>
        </section>
    </main>
</Base>

<style>
    .summary {
        margin: 0;
    }

    .features {
        margin-top: var(--section-y);
    }
</style>
