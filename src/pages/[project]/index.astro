---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import FeatureCard from '../../components/FeatureCard.astro';
import Base from '../../layouts/Base.astro';
import { projectKeys, projects } from '../../data/projects';

// 카드가 하나도 없는 프로젝트는 페이지를 만들지 않는다 (CI 에는 초안이 없으므로 공개 카드가 생길 때 나타난다)
export async function getStaticPaths() {
    const entries = await getCollection('features');
    return projectKeys
        .map((key) => ({
            key,
            items: entries.filter((entry) => entry.data.project === key).sort((a, b) => a.data.order - b.data.order),
        }))
        .filter(({ items }) => items.length > 0)
        .map(({ key, items }) => ({ params: { project: key }, props: { key, items } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { key, items } = Astro.props as Props;
const project = projects[key];
---

<Base title={`${project.name} · 이상진`} description={project.summary} image={`/og/${key}.png`}>
    <main id="main" class="container project-page">
        <nav class="crumbs" aria-label="경로">
            <a href="/">홈</a> ›
        </nav>
        <h1>{project.name}</h1>
        <p class="summary">{project.summary}</p>
        <p class="meta">
            {project.role} · {project.stack.join(' · ')}
        </p>

        <h2 class="section-label">담당 기능 {items.length}</h2>
        <ul class="feature-grid">
            {items.map((entry) => (
                <FeatureCard entry={entry} />
            ))}
        </ul>
    </main>
</Base>

<style>
    .project-page {
        padding-top: 2.5rem;
    }

    h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.75rem, 5vw, 2.25rem);
    }

    .summary {
        max-width: var(--read-width);
        margin: 0 0 0.5rem;
        font-size: 1.0625rem;
    }

    .meta {
        margin: 0 0 2.5rem;
        color: var(--muted);
        font-size: var(--text-sm);
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
