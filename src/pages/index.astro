---
import { getCollection } from 'astro:content';
import EvidenceBadges from '../components/EvidenceBadges.astro';
import GlanceRows from '../components/GlanceRows.astro';
import Base from '../layouts/Base.astro';
import { highlights } from '../data/highlights';
import { profile } from '../data/profile';
import { projectKeys, projects } from '../data/projects';
import { skills } from '../data/skills';

// 링크는 대상 페이지가 있을 때만 건다 — 공개 카드가 없으면 상세 · 프로젝트 페이지도 없다
const entries = await getCollection('features');
const cardsOf = (key: string) =>
    entries.filter((entry) => entry.data.project === key).sort((a, b) => a.data.order - b.data.order);
// 대표 사례 — 카드에 '한눈에'(노션 공개용 사본의 성과 제목 · 문제 · 해결 · 결과)가 있으면 그것을 싣고,
// 없으면 대표 수치(값 · 한 줄 설명)로 둔다. 큰 숫자 · 근거 배지 · 순서는 src/data/highlights.ts (docs/design.md 5.1)
const cases = highlights.map((item) => {
    const entry = entries.find((card) => card.data.project === item.project && card.id === item.slug);
    return { item, href: entry ? `/${item.project}/${item.slug}/` : null, glance: entry?.data.glance ?? null };
});
const showcase = cases.some((entry) => entry.glance);
// 검색 엔진용 인물 정보 (docs/design.md 10장)
const person = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.role,
    url: Astro.site?.href,
    email: `mailto:${profile.email}`,
    sameAs: [profile.github],
};
---

<Base
    title={`${profile.name} · ${profile.role}`}
    description={`측정 가능한 시스템 개선에 집중하는 ${profile.role} ${profile.name}의 포트폴리오`}
>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <main id="main" class="home container">
        <section class="hero" aria-labelledby="hero-name">
            <p class="eyebrow">
                {profile.role} · {profile.career}
            </p>
            <h1 id="hero-name">{profile.name}</h1>
            <p class="tagline">{profile.tagline}</p>
            <p class="contacts">
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
                <a href={profile.github}>{profile.github.replace('https://', '')}</a>
            </p>
        </section>

        <section aria-labelledby="highlights-title">
            <h2 id="highlights-title" class="section-label">
                {showcase ? '대표 사례' : '대표 수치'}
            </h2>
            <ul class:list={['metrics', { cases: showcase }]}>
                {cases.map(({ item, href, glance }) =>
                    glance ? (
                        <li class="metric case">
                            <p class="metric-value">{item.value}</p>
                            <h3 class="case-headline">{glance.headline}</h3>
                            <EvidenceBadges kinds={[item.evidence]} env={item.env} />
                            <GlanceRows
                                problem={glance.problem}
                                solution={glance.solution}
                                result={glance.result}
                                compact
                            />
                            {href && (
                                <a class="metric-link" href={href}>
                                    {item.cardTitle} 자세히 →
                                </a>
                            )}
                        </li>
                    ) : (
                        <li class="metric">
                            <p class="metric-value">{item.value}</p>
                            <p class="metric-label">{item.label}</p>
                            <EvidenceBadges kinds={[item.evidence]} env={item.env} />
                            {href && (
                                <a class="metric-link" href={href}>
                                    {item.cardTitle} →
                                </a>
                            )}
                        </li>
                    )
                )}
            </ul>
        </section>

        <section aria-labelledby="skills-title">
            <h2 id="skills-title" class="section-label">
                스킬
            </h2>
            <ul class="skills">
                {skills.map((skill) => (
                    <li>
                        <h3>{skill.group}</h3>
                        <p>{skill.items.join(' · ')}</p>
                    </li>
                ))}
            </ul>
        </section>

        <section aria-labelledby="projects-title">
            <h2 id="projects-title" class="section-label">
                프로젝트
            </h2>
            {projectKeys.map((key) => {
                const project = projects[key];
                const cards = cardsOf(key);
                return (
                    <article class="project">
                        <div class="project-head">
                            <h3>{project.name}</h3>
                            {cards.length > 0 && <a href={`/${key}/`}>프로젝트 보기 →</a>}
                        </div>
                        <p class="project-summary">{project.summary}</p>
                        <p class="project-meta">
                            {project.role} · {project.stack.join(' · ')}
                        </p>
                        {cards.length > 0 && (
                            <ul class="chip-list">
                                {cards.map((card) => (
                                    <li>
                                        <a class="chip" href={`/${key}/${card.id}/`}>
                                            {card.data.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </article>
                );
            })}
        </section>
    </main>
</Base>

<style>
    .home {
        padding-top: 3.5rem;
    }

    .home > section + section {
        margin-top: 3.5rem;
    }

    .hero {
        max-width: var(--read-width);
    }

    .hero h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 6vw, 2.75rem);
    }

    .tagline {
        margin: 0 0 1rem;
        font-size: 1.125rem;
        line-height: 1.65;
    }

    .contacts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin: 0;
        font-size: var(--text-sm);
    }

    .metrics,
    .skills {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .metrics {
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 0.75rem;
    }

    .metric {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.125rem 1.25rem;
        border-radius: var(--radius-lg);
        background: var(--surface);
    }

    .metric-value {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .metric-label {
        margin: 0;
        color: var(--muted);
        font-size: var(--text-sm);
        line-height: 1.55;
    }

    /* 대표 사례: 큰 숫자 · 성과 제목 · 문제 · 해결 · 결과 첫 줄 — 넓으면 2열, 좁으면 1열 */
    .metrics.cases {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    }

    .case {
        gap: 0.625rem;
        padding: 1.25rem 1.375rem;
    }

    .case-headline {
        margin: 0;
        font-size: 1.0625rem;
        line-height: 1.5;
    }

    .metric-link {
        margin-top: auto;
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .skills {
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: 1.25rem 2rem;
    }

    .skills h3 {
        margin: 0 0 0.25rem;
        font-size: 0.9375rem;
    }

    .skills p {
        margin: 0;
        color: var(--muted);
        font-size: var(--text-sm);
        line-height: 1.6;
    }

    .project {
        padding: 1.25rem 0;
        border-top: 1px solid var(--border);
    }

    .project-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.25rem 1rem;
    }

    .project-head h3 {
        margin: 0;
        font-size: 1.1875rem;
    }

    .project-head a {
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .project-summary {
        max-width: var(--read-width);
        margin: 0.5rem 0 0.25rem;
    }

    .project-meta {
        margin: 0 0 0.875rem;
        color: var(--muted);
        font-size: var(--text-sm);
    }
</style>
