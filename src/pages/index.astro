---
import { getCollection } from 'astro:content';
import EvidenceBadges from '../components/EvidenceBadges.astro';
import Base from '../layouts/Base.astro';
import { highlights } from '../data/highlights';
import { profile } from '../data/profile';
import { projectKeys, projects } from '../data/projects';
import { skills } from '../data/skills';

// 링크는 대상 페이지가 있을 때만 건다 — 공개 카드가 없으면 상세 · 프로젝트 페이지도 없다
const entries = await getCollection('features');
const cardsOf = (key: string) =>
    entries.filter((entry) => entry.data.project === key).sort((a, b) => a.data.order - b.data.order);
const hasCard = (project: string, slug: string) =>
    entries.some((entry) => entry.data.project === project && entry.id === slug);
---

<Base
    title={`${profile.name} · ${profile.role}`}
    description={`측정 가능한 시스템 개선에 집중하는 ${profile.role} ${profile.name}의 포트폴리오`}
>
    <main id="main" class="home container">
        <section class="hero" aria-labelledby="hero-name">
            <p class="eyebrow">
                {profile.role} · {profile.career}
            </p>
            <h1 id="hero-name">{profile.name}</h1>
            <p class="tagline">{profile.tagline}</p>
            <p class="contacts">
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
                <a href={profile.github}>{profile.github.replace('https://', '')}</a>
            </p>
        </section>

        <section aria-labelledby="highlights-title">
            <h2 id="highlights-title" class="section-label">
                대표 수치
            </h2>
            <ul class="metrics">
                {highlights.map((item) => (
                    <li class="metric">
                        <p class="metric-value">{item.value}</p>
                        <p class="metric-label">{item.label}</p>
                        <EvidenceBadges kinds={[item.evidence]} env={item.env} />
                        {hasCard(item.project, item.slug) && (
                            <a class="metric-link" href={`/${item.project}/${item.slug}/`}>
                                {item.cardTitle} →
                            </a>
                        )}
                    </li>
                ))}
            </ul>
        </section>

        <section aria-labelledby="skills-title">
            <h2 id="skills-title" class="section-label">
                스킬
            </h2>
            <ul class="skills">
                {skills.map((skill) => (
                    <li>
                        <h3>{skill.group}</h3>
                        <p>{skill.items.join(' · ')}</p>
                    </li>
                ))}
            </ul>
        </section>

        <section aria-labelledby="projects-title">
            <h2 id="projects-title" class="section-label">
                프로젝트
            </h2>
            {projectKeys.map((key) => {
                const project = projects[key];
                const cards = cardsOf(key);
                return (
                    <article class="project">
                        <div class="project-head">
                            <h3>{project.name}</h3>
                            {cards.length > 0 && <a href={`/${key}/`}>프로젝트 보기 →</a>}
                        </div>
                        <p class="project-summary">{project.summary}</p>
                        <p class="project-meta">
                            {project.role} · {project.stack.join(' · ')}
                        </p>
                        {cards.length > 0 && (
                            <ul class="chip-list">
                                {cards.map((card) => (
                                    <li>
                                        <a class="chip" href={`/${key}/${card.id}/`}>
                                            {card.data.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </article>
                );
            })}
        </section>
    </main>
</Base>

<style>
    .home {
        padding-top: 3.5rem;
    }

    .home > section + section {
        margin-top: 3.5rem;
    }

    .hero {
        max-width: var(--read-width);
    }

    .hero h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 6vw, 2.75rem);
    }

    .tagline {
        margin: 0 0 1rem;
        font-size: 1.125rem;
        line-height: 1.65;
    }

    .contacts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin: 0;
        font-size: var(--text-sm);
    }

    .metrics,
    .skills {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .metrics {
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 0.75rem;
    }

    .metric {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.125rem 1.25rem;
        border-radius: var(--radius-lg);
        background: var(--surface);
    }

    .metric-value {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .metric-label {
        margin: 0;
        color: var(--muted);
        font-size: var(--text-sm);
        line-height: 1.55;
    }

    .metric-link {
        margin-top: auto;
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .skills {
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: 1.25rem 2rem;
    }

    .skills h3 {
        margin: 0 0 0.25rem;
        font-size: 0.9375rem;
    }

    .skills p {
        margin: 0;
        color: var(--muted);
        font-size: var(--text-sm);
        line-height: 1.6;
    }

    .project {
        padding: 1.25rem 0;
        border-top: 1px solid var(--border);
    }

    .project-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.25rem 1rem;
    }

    .project-head h3 {
        margin: 0;
        font-size: 1.1875rem;
    }

    .project-head a {
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .project-summary {
        max-width: var(--read-width);
        margin: 0.5rem 0 0.25rem;
    }

    .project-meta {
        margin: 0 0 0.875rem;
        color: var(--muted);
        font-size: var(--text-sm);
    }
</style>
