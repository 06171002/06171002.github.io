---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { projectKeys, projects } from '../data/projects';
import { skills } from '../data/skills';
import { skillIcons } from '../data/skill-icons';

// 링크는 대상 페이지가 있을 때만 건다 — 공개 카드가 없으면 프로젝트 페이지도 없다
const entries = await getCollection('features');
const hasPage = (key: string) => entries.some((entry) => entry.data.project === key);
// 검색 엔진용 인물 정보 (docs/design.md 10장)
const person = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.role,
    url: Astro.site?.href,
    email: `mailto:${profile.email}`,
    sameAs: [profile.github],
};
---

<Base
    title={`${profile.name} · ${profile.role}`}
    description={`측정 가능한 시스템 개선에 집중하는 ${profile.role} ${profile.name}의 포트폴리오`}
>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <main id="main" class="container home">
        <header class="intro">
            <h1 id="hero-name">
                {profile.wordmark}
                <span class="dot">.</span>
            </h1>
            <p class="intro-sub">
                {profile.role} · {profile.career}
            </p>
        </header>

        <section class="home-block" aria-labelledby="about-title">
            <h2 id="about-title" class="section-label">
                About
            </h2>
            <p class="home-text">{profile.tagline}</p>
            <div class="home-links">
                <a class="btn btn-secondary" href={profile.github}>
                    GitHub <span aria-hidden="true">↗</span>
                </a>
                <a class="btn btn-secondary" href={`mailto:${profile.email}`}>
                    메일 보내기
                </a>
            </div>
        </section>

        <section id="projects" class="home-block" aria-labelledby="projects-title">
            <h2 id="projects-title" class="section-label">
                Projects
            </h2>
            <ol class="row-list">
                {projectKeys.map((key) => {
                    const project = projects[key];
                    const Row = hasPage(key) ? 'a' : 'div';
                    return (
                        <li>
                            <Row href={hasPage(key) ? `/${key}/` : undefined} class={hasPage(key) ? undefined : 'row'}>
                                <span class="row-info">
                                    <span class="row-title">{project.name}</span>
                                    <span class="row-sub">{project.stack.join(' · ')}</span>
                                </span>
                                <span class="row-side">{project.role}</span>
                            </Row>
                        </li>
                    );
                })}
            </ol>
        </section>

        <section class="home-block" aria-labelledby="skills-title">
            <h2 id="skills-title" class="section-label">
                Skills
            </h2>
            <ul class="skill-rows">
                {skills.map((skill) => (
                    <li>
                        <h3 class="skill-group">{skill.group}</h3>
                        <ul class="chip-list">
                            {skill.items.map((item) => {
                                const icon = skillIcons[item];
                                return (
                                    <li class="chip">
                                        {icon && (
                                            <svg
                                                class="chip-icon"
                                                viewBox="0 0 24 24"
                                                aria-hidden="true"
                                                focusable="false"
                                            >
                                                <path d={icon.path} />
                                            </svg>
                                        )}
                                        {item}
                                    </li>
                                );
                            })}
                        </ul>
                    </li>
                ))}
            </ul>
        </section>
    </main>
</Base>

<style>
    /* ---------- 첫 머리: 굵은 인사 두 줄 + 회색 한 줄 ---------- */
    .intro {
        padding: 4rem 0 2.5rem;
    }

    @media (min-width: 640px) {
        .intro {
            padding-top: 6rem;
        }
    }

    .intro h1 {
        margin: 0 0 0.375rem;
        font-size: 1.0625rem;
        font-weight: 700;
        line-height: 1.7;
        letter-spacing: -0.01em;
    }

    .intro .dot {
        color: var(--muted);
    }

    .intro-sub {
        margin: 0;
        color: var(--muted);
        font-size: var(--text-sm);
        line-height: 1.6;
    }

    /* ---------- 구간: 회색 라벨 → 내용, 구간 사이 44px ---------- */
    .home-block + .home-block {
        margin-top: var(--section-y);
    }

    .home-text {
        margin: 0;
    }

    .home-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
    }

    /* ---------- 스킬: 줄마다 왼쪽 묶음 이름 · 오른쪽 칩 ---------- */
    .skill-rows {
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--border);
        list-style: none;
    }

    .skill-rows > li {
        display: grid;
        gap: 0.625rem;
        padding: 0.9375rem 0;
        border-bottom: 1px solid var(--border);
    }

    @media (min-width: 640px) {
        .skill-rows > li {
            grid-template-columns: 7rem minmax(0, 1fr);
            align-items: baseline;
            gap: 1rem;
        }
    }

    .skill-group {
        margin: 0;
        font-size: var(--text-sm);
        font-weight: 500;
        line-height: 1.7;
    }
</style>
